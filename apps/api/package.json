{
  "name": "@gof/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Minimal node:http API serving daily challenges without leaking answers.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --sourcemap --outfile=dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gof/core": "*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
