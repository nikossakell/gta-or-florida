// Cloudflare Worker API for GTA or Florida?
// Bindings are NOT inherited between environments, so each env declares its own.
// D1 databases already exist in the Cloudflare account — do NOT run `wrangler d1 create` again:
//   staging    → gta-or-florida-staging     (beb1f5d9-b4bf-4f46-ab25-28833fc531a1)
//   production → gta-or-florida-production  (848c6f92-bd9a-4934-8374-cfa2d6f45fd5)
// database_id values are identifiers, not secrets. Always pass --env: the top level has no D1
// binding, so a bare `wrangler deploy` / `wrangler d1 migrations apply` reaches neither database.
// Secrets (never in this file): wrangler secret put INGESTION_IMPORT_TOKEN --env <env>
//                               wrangler secret put ADMIN_TOKEN --env <env>
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gta-florida-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "env": {
    // `npm run dev:worker` — local workerd + local D1 emulator (.wrangler/state, git-ignored).
    "local": {
      "vars": {
        "APP_ENV": "local",
        "AUTO_PUBLISH_MODE": "shadow",
        "FRONTEND_ORIGIN": "http://localhost:5173",
        "EXTRA_ORIGINS": "http://127.0.0.1:5173,http://localhost:4173"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gta-florida-local",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    },
    "staging": {
      "vars": {
        "APP_ENV": "staging",
        "AUTO_PUBLISH_MODE": "shadow",
        // Pages preview deployments: https://<hash-or-branch>.<project>.pages.dev
        "PAGES_PREVIEW_PROJECT": "gta-or-florida",
        "FRONTEND_ORIGIN": "https://staging.gta-or-florida.pages.dev",
        // Standalone staging Pages project (exact match; its subdomains are NOT allowed).
        "EXTRA_ORIGINS": "https://gta-or-florida-staging.pages.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gta-or-florida-staging",
          "database_id": "beb1f5d9-b4bf-4f46-ab25-28833fc531a1",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
      // One expression (00:05 + 12:05 UTC): Workers Free allows 5 Cron Triggers per ACCOUNT, shared with the ingestion Worker.
      "triggers": { "crons": ["5 0,12 * * *"] }
    },
    "production": {
      "vars": {
        "APP_ENV": "production",
        // off | shadow | trusted_sources — stays shadow until the owner has a benchmark (README_DEPLOYMENT.md).
        "AUTO_PUBLISH_MODE": "shadow",
        "FRONTEND_ORIGIN": "https://gta-or-florida.pages.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gta-or-florida-production",
          "database_id": "848c6f92-bd9a-4934-8374-cfa2d6f45fd5",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }],
      // One expression (00:05 + 12:05 UTC): Workers Free allows 5 Cron Triggers per ACCOUNT, shared with the ingestion Worker.
      "triggers": { "crons": ["5 0,12 * * *"] }
    }
  }
}
