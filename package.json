{
  "name": "gta-or-florida",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "GTA or Florida? \u2014 a daily trivia game: real Florida news or a documented GTA in-game event? (Cloudflare Pages + Workers + D1)",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "scripts"
  ],
  "scripts": {
    "dev": "concurrently -k -n worker,web -c magenta,cyan \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:worker": "tsx scripts/seed-local.ts --vars-only && npm run db:migrate:local && npm run dev -w @gof/worker",
    "dev:web": "npm run dev -w @gof/web",
    "dev:ingest": "npx wrangler dev -c apps/ingest-worker/wrangler.jsonc -c apps/worker/wrangler.jsonc --env local --port 8788 --persist-to apps/worker/.wrangler/state",
    "dev:seed": "tsx --env-file-if-exists=.env scripts/seed-local.ts",
    "review": "npm run start -w @gof/review",
    "db:migrate:local": "npm run db:migrate:local -w @gof/worker",
    "build": "npm run build -w @gof/web && npm run build -w @gof/worker",
    "build:web": "npm run build -w @gof/web",
    "build:pages": "npm run build:pages -w @gof/web && tsx scripts/build-pages.ts",
    "preview:pages": "npm run preview -w @gof/web -- --mode pages",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx scripts/validate-questions.ts && tsx scripts/check-config.ts",
    "schedule:build": "tsx scripts/build-daily-schedule.ts",
    "schedule:simulate": "tsx scripts/simulate-schedule.ts",
    "ci": "npm run typecheck && npm run test && npm run validate",
    "ingest:batch": "tsx --env-file-if-exists=.env apps/ingest/src/run.ts",
    "ingest:url": "tsx --env-file-if-exists=.env apps/ingest/src/ingest-url.ts",
    "ingest:official": "tsx --env-file-if-exists=.env apps/ingest/src/ingest-official.ts",
    "bank:import": "tsx --env-file-if-exists=.env apps/ingest/src/bank-import.ts",
    "bank:approve": "tsx --env-file-if-exists=.env apps/ingest/src/bank-approve.ts",
    "admin": "tsx --env-file-if-exists=.env apps/ingest/src/admin.ts",
    "legacy:export": "tsx apps/ingest/src/legacy.ts export",
    "legacy:import": "tsx --env-file-if-exists=.env apps/ingest/src/legacy.ts import",
    "smoke": "tsx scripts/smoke.ts",
    "deploy:worker:staging": "npm run deploy:staging -w @gof/worker",
    "deploy:worker:production": "npm run deploy:production -w @gof/worker",
    "check:ingest:staging": "npm run check:staging -w @gof/ingest-worker",
    "deploy:ingest:staging": "npm run deploy:staging -w @gof/ingest-worker",
    "deploy:ingest:production": "npm run deploy:production -w @gof/ingest-worker"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
