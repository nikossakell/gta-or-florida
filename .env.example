# GTA or Florida? — configuration reference. Copy to .env (git-ignored) for local Node tooling.
# These are OUR application's settings, not third-party platform variables.
# Never put secrets in VITE_* variables: they are baked into the public browser bundle.
#
# Where each value lives in production:
#   Pages build vars ........ VITE_API_BASE_URL, VITE_PUBLIC_URL
#   Worker vars (wrangler) .. APP_ENV, APP_VERSION, AUTO_PUBLISH_MODE, FRONTEND_ORIGIN, EXTRA_ORIGINS, PAGES_PREVIEW_PROJECT,
#                             AUTO_PUBLISH_MAX_FALSE_APPROVAL_RATE, HUMAN_SAMPLE_RATE, SCHEDULE_AHEAD_DAYS, EVENT_COOLDOWN_DAYS
#   Worker secrets .......... INGESTION_IMPORT_TOKEN, ADMIN_TOKEN       (wrangler secret put … --env staging|production)
#   Cloudflare build vars ... SMOKE_URL (Workers Builds, optional post-deploy smoke); Pages: the VITE_* above
#   Local .env only ......... INGESTION_IMPORT_TOKEN, CF_AI_ACCOUNT_ID, CF_AI_API_TOKEN, INGESTION_API_URL (CLI tools)
#   (GitHub Actions is retired: no GitHub secrets/variables are used.)
# Staging and production use DIFFERENT secret values.

# --- Web (apps/web, Cloudflare Pages build) ----------------------------------
# Worker origin for this build. Empty = same-origin /api (Vite dev proxy → wrangler dev on :8787).
VITE_API_BASE_URL=https://gta-florida-api-staging.nikossakell02.workers.dev
# Share-text URL; defaults to the page origin.
# VITE_PUBLIC_URL=https://<your-pages-project>.pages.dev
# Vite dev-server proxy target for /api.
# API_URL=http://127.0.0.1:8787

# --- Worker runtime (apps/worker/wrangler.jsonc vars; locally from env "local") ---
# APP_ENV=local                       # local | staging | production (fixtures exist only in local)
# APP_VERSION=dev
# AUTO_PUBLISH_MODE=shadow            # off | shadow | trusted_sources (unknown → off)
# AUTO_PUBLISH_MAX_FALSE_APPROVAL_RATE=   # owner-set from a recorded benchmark; unset → nothing auto-approves
# HUMAN_SAMPLE_RATE=0.1               # share of auto-eligible items still routed to a human (min 0.05)
# FRONTEND_ORIGIN=https://<your-pages-project>.pages.dev
# EXTRA_ORIGINS=http://localhost:5173
# PAGES_PREVIEW_PROJECT=<your-pages-project>   # allows https://<hash>.<project>.pages.dev previews (staging)
# SCHEDULE_AHEAD_DAYS=30              # days the cron keeps scheduled ahead (1-90; 30 or 90 are the documented horizons)
# EVENT_COOLDOWN_DAYS=30              # an event is not shown again within this many days (default 30)
# Secrets — set with wrangler, or apps/worker/.dev.vars locally (see .dev.vars.example):
# INGESTION_IMPORT_TOKEN=<64 hex chars: openssl rand -hex 32>
# ADMIN_TOKEN=<a different 64 hex chars>

# --- Ingestion CLI (apps/ingest, local) --------------------------------------
# Worker base URL (origin or the full …/api/v1/admin/import URL).
INGESTION_API_URL=http://127.0.0.1:8787
INGESTION_IMPORT_TOKEN=
# Workers AI REST (batch only). Without both, AI_PROVIDER=auto falls back to the deterministic mock.
CF_AI_ACCOUNT_ID=
CF_AI_API_TOKEN=
# auto | workers-ai | mock | off
AI_PROVIDER=auto
GRAND_THEFT_WIKI_API=https://www.grandtheftwiki.com/api.php
# Generic client name sent upstream (no personal contact details).
# HTTP_USER_AGENT=gta-or-florida-ingest/0.3 (unofficial fan trivia project; metadata only)

# --- Ingestion Worker (apps/ingest-worker/wrangler.jsonc vars; secrets via wrangler) ---
# Scheduled ingestion runs on Cloudflare (Cron Trigger → Workflow), not GitHub Actions.
# Secret: INGESTION_IMPORT_TOKEN (same value as that env's API Worker): wrangler secret put … --env <env>
# INGEST_ENABLED=false              # "true" lets the cron start runs; manual `wrangler workflows trigger` always works
# AI_PROVIDER=binding               # Worker: binding | mock | off (the CLI above uses auto | workers-ai | mock | off)
# GDELT_ENABLED=true                # optional Florida fallback, used only when approved RSS feeds return < GDELT_MIN_RSS_ITEMS
# GDELT_QUERIES=1
# GDELT_MIN_RSS_ITEMS=10
# Workers Free sizing (10 ms CPU / step, 50 subrequests, 1,024 steps / instance, 3,000 steps / day):
# SCAN_PAGE_SIZE=25                 # existing incidents per fuzzy-dedupe step
# SCAN_CANDIDATES=10                # candidates per fuzzy-dedupe step
# PROCESS_BATCH=4                   # items per link-check + AI step
# MAX_LINK_CHECKS=15
# MAX_WIKI_PAGES=15
# MAX_FEEDS=5
# MAX_AI_REQUESTS=30
# MAX_NEURONS=2500                  # per run; the account's free allocation is 10,000 neurons/day, shared by ALL envs
# MAX_STEPS=900                     # run refuses to start a step past this (Free limit: 1,024 per instance)
# LOW_INVENTORY_DAYS=14             # "ingest.inventory_low" log event below this runway
# Florida sources, most trustworthy first:
# DOJ_ENABLED=true                  # Florida U.S. Attorney's Offices press releases (public domain; justice.gov API)
# DOJ_LOOKBACK_DAYS=2               # ~62 releases/day department-wide → ~3 API pages per run
# DOJ_MAX_PAGES=6
# DOJ_INCLUDE_ALLEGATIONS=false     # false: only convictions / guilty pleas / sentences become candidates
# DOJ_MIN_UNUSUAL=2                 # releases below this unusualness score are recorded as NOT_UNUSUAL (0 = off)
# DOJ_BACKFILL_ENABLED=false        # one-off historical backfill, stops itself at DOJ_BACKFILL_DAYS
# DOJ_BACKFILL_DAYS=365
# DOJ_BACKFILL_PAGES_PER_RUN=25     # max pages per backfill INSTANCE (one page per step); the subrequest plan may stop earlier
# DOJ_BACKFILL_CHAIN=true           # a backfill instance with pages left starts its successor (one at a time)
# DOJ_BACKFILL_LEASE_MINUTES=60     # one backfill instance at a time; the lease expires if an instance dies
# SUBREQUEST_BUDGET=45              # planned subrequests per Workflow INSTANCE (Workers Free: 50/invocation incl. Service Binding calls)
# TITLE_PAGES_PER_KIND=2            # title-index pages (500 incidents each) reserved per kind for fuzzy dedupe
# FM_DATASET_ENABLED=false          # "Florida Man API" historical dataset: STAGING ONLY (refused in production)
# FM_DATASET_DAYS_PER_RUN=2         # calendar-day files per run (~18 KB each)

# --- Owner admin CLI (npm run admin -- …) --------------------------------------
# ADMIN_API_URL=https://gta-florida-api-staging.<your-subdomain>.workers.dev
# ADMIN_TOKEN=
# Name recorded in the audit log (defaults to your OS user name).
# REVIEWER=

# --- Tooling -------------------------------------------------------------------
# npm run dev:seed target (local wrangler dev only)
# LOCAL_WORKER_URL=http://127.0.0.1:8787
# npm run smoke -- <url>  (or set SMOKE_URL)
# SMOKE_URL=
# REQUIRE_TODAY=1                     # smoke fails when today's round is missing (daily heartbeat)
# Legacy static demo build (Netlify / GitHub Pages) until cutover:
# ALLOW_PLACEHOLDER_CONTENT=true
# DATA_DIR=./data
# ARCHIVE_DAYS=7
# TIME_LIMIT_SECONDS=60
