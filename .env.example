# Copy to .env (git-ignored). Every value is optional; defaults shown.
# No secrets are needed for the MVP: GDELT DOC 2.0 requires no API key.

# --- API server (apps/api) ---------------------------------------------------
# NODE_ENV=production
PORT=8787
# Use 0.0.0.0 inside containers / behind a reverse proxy.
HOST=127.0.0.1
# Defaults to <repo>/data
# DATA_DIR=
# Built SPA served by the API; defaults to apps/web/dist when it exists.
# WEB_DIST_DIR=
# SERVE_WEB=false
# Serve development placeholder questions. Defaults to true unless NODE_ENV=production.
# ALLOW_PLACEHOLDER_CONTENT=false
ARCHIVE_DAYS=7
TIME_LIMIT_SECONDS=60
RATE_LIMIT_PER_MINUTE=120
# Only enable behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
LOG_REQUESTS=false

# --- Web (apps/web) -----------------------------------------------------------
# PUBLIC: baked into the browser bundle at build time. Never put secrets in VITE_* vars.
# URL shown in share text; defaults to the page origin.
# VITE_PUBLIC_URL=https://example.com
# Vite dev-server proxy target for /api
# API_URL=http://127.0.0.1:8787

# --- Ingestion scripts (scripts/) ---------------------------------------------
# DATA_DIR is honoured by the CLI scripts too.
